# ============================================================================
# 智衡 Copilot 环境变量示例
#
# 使用方法：复制本文件为 .env（cp .env.example .env），再按实际环境修改。
# .env 已被 .gitignore 忽略，请勿提交到仓库。
#
# ⚠️ 生产部署必须修改以下三项，严禁使用默认值上线：
#   - POSTGRES_PASSWORD      数据库密码
#   - SEED_ADMIN_PASSWORD    首次启动创建的 admin 账号密码
#   - SEED_DEMO_PASSWORD     首次启动创建的 demo 账号密码
# ============================================================================

# ---- Web（前端 nginx）----
# 浏览器访问入口端口，访问地址为 http://<公网IP>:${WEB_PORT}
WEB_PORT=8080

# ---- 数据库（PostgreSQL）----
POSTGRES_DB=zhiheng_copilot
POSTGRES_USER=postgres
# 生产必须修改
POSTGRES_PASSWORD=change-me-in-production

# ---- 后端 API ----
# 容器编排内保持默认即可（db 为服务名）；仅在本机直连数据库时才需要覆盖
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/zhiheng_copilot
APP_NAME=Zhiheng Copilot API
# 同机同域部署下前端经 nginx 反代访问 /api，无需配置跨域；仅在本机 vite dev 联调时使用
# CORS_ORIGINS=http://localhost:5173
# API 容器内数据目录（交付物等文件存储）
API_DATA_DIR=/data
# 上传文件大小上限（字节），默认 100MB，需与 client/nginx.conf 的 client_max_body_size 对齐
MAX_UPLOAD_FILE_SIZE_BYTES=104857600

# ---- 认证 ----
# 生产环境必须保持 false（true 仅用于本地开发调试）
AUTH_DISABLED=false
AUTH_TOKEN_TTL_HOURS=24
# 首次启动种子账号密码，生产必须修改；首次登录后请立即在管理页再次修改
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_DEMO_PASSWORD=change-me-in-production

# ---- LLM（AI 任务）----
# mock 为模拟数据；真实解析改为 kimi 并填写 KIMI_API_KEY
LLM_PROVIDER=mock
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_TIMEOUT_SECONDS=60
# 计费单价（每百万 token），用于成本统计展示，可按实际套餐填写
KIMI_INPUT_PRICE_PER_MTOK=0
KIMI_OUTPUT_PRICE_PER_MTOK=0
